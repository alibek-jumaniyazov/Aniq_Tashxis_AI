# Windows quick start uses SQLite and a persistent local job ledger.
# PostgreSQL/Redis profile is available via compose.yaml.
DEMO_MODE=true
SEED_PROFILE=realistic
QUEUE_MODE=local
AI_PROVIDER=local_medgemma
AI_BACKEND=transformers
# Remote alternative: set AI_PROVIDER=openai and AI_BACKEND=openai.
# Keep the key server-only in .env; never use a VITE_ variable for credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=high
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_MAX_INPUT_CHARS=200000
# Optional lightweight Windows profile: scripts/download_gguf.py sets AI_BACKEND=llama_cpp.
LLAMA_SERVER_URL=http://127.0.0.1:8081
MODEL_ID=google/medgemma-1.5-4b-it
MODEL_PATH=
MODEL_REVISION=main
MODEL_QUANTIZATION=4bit
MODEL_GPU_MEMORY_GB=3
MODEL_CPU_MEMORY_GB=4
MAX_INPUT_TOKENS=6000
MAX_NEW_TOKENS=1200
INFERENCE_TIMEOUT_SECONDS=150
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000
# Set only after a real public HTTPS domain is deployed. Local/staging remain noindex.
SITE_URL=
SEO_INDEXING_ENABLED=false
# HF_TOKEN must be set privately in the terminal for model download only.
