{
  "name": "aniqtashxis-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:seed": "playwright test --config playwright.seed.config.ts",
    "api:types": "openapi-typescript ../docs/openapi.json -o src/api/generated.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@fontsource/manrope": "^5.2.6",
    "@tanstack/react-query": "^5.85.0",
    "antd": "^5.27.0",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "i18next": "^25.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.54.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^6.3.0",
    "vitest": "4.1.11"
  }
}
